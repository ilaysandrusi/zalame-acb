{
  "mcpServers": {
    "getlayers": {
      "url": "https://mcp.getlayers.ai/mcp"
    },
    "ruflo": {
      "command": "npx",
      "args": [
        "-y",
        "ruflo@latest",
        "mcp",
        "start",
        "--tools",
        "agent_spawn,agent_execute,agent_terminate,agent_status,agent_list,agent_pool,agent_health,agent_update,agent_logs,swarm_init,swarm_status,swarm_shutdown,swarm_health,memory_store,memory_retrieve,memory_search,memory_delete,memory_list,memory_stats,memory_search_unified,memory_cleanup"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "15",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid",
        "CLAUDE_FLOW_MCP_TOOLS": "agent_spawn,agent_execute,agent_terminate,agent_status,agent_list,agent_pool,agent_health,agent_update,agent_logs,swarm_init,swarm_status,swarm_shutdown,swarm_health,memory_store,memory_retrieve,memory_search,memory_delete,memory_list,memory_stats,memory_search_unified,memory_cleanup"
      }
    }
  }
}
